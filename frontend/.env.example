# URL where the FastAPI backend is reachable by the browser.
# Local development default is http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase browser-safe project credentials (never use a service-role key here).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
